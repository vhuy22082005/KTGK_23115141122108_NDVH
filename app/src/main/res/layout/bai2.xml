<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quản lý chi tiêu"
        android:textColor="#000"
        android:textSize="18sp"
        android:textStyle="bold">

    </TextView>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardprofile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#FFF"
        app:cardCornerRadius="12sp"
        app:cardElevation="2sp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <TextView
                android:id="@+id/khoanchi_108"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tên khoản chi"
                android:textSize="16sp"
                android:textColor="#000"
                android:textStyle="bold">
            </TextView>
            <TextView
                android:id="@+id/txtkhoanchi_108"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="Nhập tên khoản chi"
                android:text="Ăn uống"
                android:layout_marginBottom="12dp"
                android:minHeight="48dp"
                android:textColor="#000"
                android:textSize="16sp"
                android:textStyle="bold">
            </TextView>
            <TextView
                android:id="@+id/sotien_108"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Số tiền"
                android:textSize="16sp"
                android:textColor="#000"
                android:textStyle="bold">

            </TextView>
            <TextView
                android:id="@+id/txtsotien_108"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="Nhập số tiền"
                android:text="500.000 đ"
                android:layout_marginBottom="12dp"
                android:minHeight="48dp"
                android:textColor="#000"
                android:textSize="16sp"
                android:textStyle="bold">
            </TextView>
            <TextView
                android:id="@+id/ghichu_108"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ghi chú"
                android:textSize="16sp"
                android:textColor="#000"
                android:textStyle="bold">

            </TextView>
            <TextView
                android:id="@+id/txtghichu_108"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="Nhập ghi chú"
                android:text="Ăn uống ngon"
                android:layout_marginBottom="12dp"
                android:minHeight="48dp"
                android:textColor="#000"
                android:textSize="16sp"
                android:textStyle="bold">
            </TextView>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnxemchitiet_108"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Xem chi tiết khoản chi"
                android:backgroundTint="#FF9800"
                android:textSize="16sp"
                android:textColor="#000"
                android:textStyle="bold">
            </com.google.android.material.button.MaterialButton>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnback_108"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Quay lại"
                android:backgroundTint="#000"
                android:textSize="16sp"
                android:textColor="#FFF"
                android:textStyle="bold">
            </com.google.android.material.button.MaterialButton>
        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>
</LinearLayout>